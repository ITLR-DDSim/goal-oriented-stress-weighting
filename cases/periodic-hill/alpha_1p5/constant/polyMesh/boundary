5
(
    inlet
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          80;
        startFace       15820;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  outlet;
    }
    outlet
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          80;
        startFace       15900;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  inlet;
    }
    topWall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          100;
        startFace       15980;
    }
    bottomWall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          100;
        startFace       16080;
    }
    defaultFaces
    {
        type            empty;
        inGroups        1(empty);
        nFaces          16000;
        startFace       16180;
    }
