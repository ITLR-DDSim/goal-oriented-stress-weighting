FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    location        "20000";
    object          omega;
}

dimensions      [ 0 0 -1 0 0 0 0 ];

internalField   uniform 1.6;

boundaryField
{
    inlet
    {
        type            cyclic;
    }
    outlet
    {
        type            cyclic;
    }
    topWall
    {
        blended         1;
        beta1           0.075;
        type            omegaWallFunction;
        value           uniform 1.6;
    }
    bottomWall
    {
        blended         1;
        beta1           0.075;
        type            omegaWallFunction;
        value           uniform 1.6;
    }
    defaultFaces
    {
        type            empty;
    }
}


