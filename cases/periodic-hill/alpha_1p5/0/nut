FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    location        "20000";
    object          nut;
}

dimensions      [ 0 2 -1 0 0 0 0 ];

internalField   uniform 0.00235;

boundaryField
{
    inlet
    {
        type            cyclic;
    }
    outlet
    {
        type            cyclic;
    }
    topWall
    {
        type            nutLowReWallFunction;
        Cmu             0.09;
        kappa           0.41;
        E               9.8;
        value           uniform 0;
    }
    bottomWall
    {
        type            nutLowReWallFunction;
        Cmu             0.09;
        kappa           0.41;
        E               9.8;
        value           uniform 0;
    }
    defaultFaces
    {
        type            empty;
    }
}


